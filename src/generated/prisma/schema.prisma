// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unidadeId Int?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  // NOVO: Múltiplas roles
  userRoles UserRoleAssignment[]

  sessions           Session[]
  accounts           Account[]
  eventosCriados     AgendaEvento[] @relation("AgendaEventoCriadoPor")
  eventosAtualizados AgendaEvento[] @relation("AgendaEventoAtualizadoPor")

  @@unique([email])
  @@map("user")
}

// NOVO: Tabela intermediária
model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// NOVO: Model de Role (substitui o enum)
model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  userRoles   UserRoleAssignment[]
  permissions RolePermission[]

  @@map("roles")
}

// OPCIONAL: Permissões granulares
model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Unidade {
  id   Int    @id @default(autoincrement())
  nome String

  ramais        Ramal[]
  emails        Email[]
  users         User[]
  recados       Recado[]                   @relation("RecadoUnidadePrincipal")
  recadosMulti  RecadoUnidade[]
  agendaEventos AgendaEvento[]
  solicitacoes  SolicitacaoGerenciamento[]

  @@map("unidades")
}

model Ramal {
  id        Int      @id @default(autoincrement())
  numero    String
  nome      String?
  setor     String
  unidadeId Int
  unidade   Unidade  @relation(fields: [unidadeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unidadeId, numero])
  @@map("ramais")
}

model Email {
  id        Int      @id @default(autoincrement())
  email     String
  nome      String?
  setor     String
  unidadeId Int
  unidade   Unidade  @relation(fields: [unidadeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unidadeId, email])
  @@map("emails")
}

model Jornal {
  id             Int      @id @default(autoincrement())
  titulo         String
  descricao      String
  imagem         String // nome do arquivo: "jornal1.jpg"
  url            String
  dataLancamento DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("jornais")
}

model Noticia {
  id        Int      @id @default(autoincrement())
  titulo    String
  conteudo  String
  imagem    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitacoes SolicitacaoGerenciamento[]

  @@map("noticias")
}

model NoticiaAudit {
  id           Int      @id @default(autoincrement())
  noticiaId    Int
  userId       String
  userNome     String
  acao         String
  dadosAntigos Json?
  dadosNovos   Json?
  createdAt    DateTime @default(now())

  @@index([noticiaId])
  @@index([userId])
  @@index([createdAt])
  @@map("noticias_audits")
}

model Recado {
  id        Int      @id @default(autoincrement())
  titulo    String
  conteudo  String
  imagem    String?
  unidadeId Int
  unidade   Unidade  @relation("RecadoUnidadePrincipal", fields: [unidadeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unidades     RecadoUnidade[]
  solicitacoes SolicitacaoGerenciamento[]

  @@map("recados")
}

model RecadoUnidade {
  id        Int @id @default(autoincrement())
  recadoId  Int
  unidadeId Int

  recado  Recado  @relation(fields: [recadoId], references: [id], onDelete: Cascade)
  unidade Unidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  // Impede duplicação (mesmo recado + mesma unidade)
  @@unique([recadoId, unidadeId])
  @@index([recadoId])
  @@index([unidadeId])
  @@map("recados_unidades")
}

model RecadoAudit {
  id           Int      @id @default(autoincrement())
  recadoId     Int
  userId       String
  userNome     String
  acao         String // "CREATE", "UPDATE", "DELETE"
  dadosAntigos Json? // Snapshot antes da mudança
  dadosNovos   Json? // Snapshot depois da mudança
  createdAt    DateTime @default(now())

  @@index([recadoId])
  @@index([userId])
  @@index([createdAt])
  @@map("recados_audits")
}

model AgendaEvento {
  id              Int      @id @default(autoincrement())
  titulo          String
  descricao       String?
  data            DateTime
  unidadeId       Int
  unidade         Unidade  @relation(fields: [unidadeId], references: [id])
  criadoPorId     String
  criadoPor       User     @relation("AgendaEventoCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoPorId String?
  atualizadoPor   User?    @relation("AgendaEventoAtualizadoPor", fields: [atualizadoPorId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([data])
  @@index([unidadeId])
  @@index([criadoPorId])
  @@map("agenda_eventos")
}

model AgendaEventoAudit {
  id           Int      @id @default(autoincrement())
  eventoId     Int
  eventoTitulo String
  unidadeId    Int
  unidadeNome  String?
  userId       String
  userNome     String
  acao         String
  dadosAntigos Json?
  dadosNovos   Json?
  createdAt    DateTime @default(now())

  @@index([eventoId])
  @@index([userId])
  @@index([createdAt])
  @@map("agenda_eventos_audits")
}

enum SolicitacaoTipo {
  CREATE
  UPDATE
  DELETE
}

enum SolicitacaoStatus {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
}

enum SolicitacaoRecurso {
  RECADO
  NOTICIA
}

model SolicitacaoGerenciamento {
  id      Int                @id @default(autoincrement())
  recurso SolicitacaoRecurso
  tipo    SolicitacaoTipo
  status  SolicitacaoStatus  @default(PENDENTE)

  recadoId Int?
  recado   Recado? @relation(fields: [recadoId], references: [id], onDelete: SetNull)

  noticiaId Int?
  noticia   Noticia? @relation(fields: [noticiaId], references: [id], onDelete: SetNull)

  unidadeId Int?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)

  unidadeIds String?

  titulo       String?
  conteudo     String?
  imagem       String?
  imagemAntiga String?
  motivoRecusa String?

  solicitanteId   String
  solicitanteNome String
  revisorId       String?
  revisorNome     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([recurso])
  @@index([solicitanteId])
  @@index([unidadeId])
  @@index([recadoId])
  @@index([noticiaId])
  @@map("solicitacoes_gerenciamento")
}
